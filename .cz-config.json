{
  "types": [
    { "value": "feat", "name": "feat     ✨: 新功能" },
    { "value": "fix", "name": "fix      🐛: 修复bug" },
    { "value": "docs", "name": "docs     📝: 文档变更" },
    {
      "value": "chore",
      "name": "chore    🚀: 对构建过程或辅助工具和库的更改（不影响源文件、测试用例）"
    },
    { "value": "style", "name": "style    💄: 代码格式（不影响功能，例如空格、分号等格式修正）" },
    { "value": "refactor", "name": "refactor ♻️: 代码重构（不包括 bug 修复、功能新增）" },
    { "value": "perf", "name": "perf     ⚡️: 性能优化" },
    { "value": "test", "name": "test     🚨: 添加、修改测试用例" },
    {
      "value": "build",
      "name": "build    📦️: 构建流程、外部依赖变更（如升级 npm 包、修改 vite 配置等）"
    },
    { "value": "ci", "name": "ci       👷: 修改 CI 配置、脚本" },
    { "value": "revert", "name": "revert   ⏪️: 回滚 commit" }
  ],
  "scopes": [
    { "value": "other", "name": "other          (其他修改)" },
    { "value": "api", "name": "api            (接口相关)" },
    { "value": "auth", "name": "auth           (认证相关)" },
    { "value": "assets", "name": "assets         (样式/图片/媒体资源相关)" },
    { "value": "components", "name": "components     (组件相关)" },
    { "value": "constant", "name": "constant       (常量相关)" },
    { "value": "dashboard", "name": "dashboard      (仪表盘相关)" },
    { "value": "deps", "name": "deps           (依赖更新)" },
    { "value": "docs", "name": "docs           (文档相关)" },
    { "value": "eslint", "name": "eslint         (ESLint 配置)" },
    { "value": "hooks", "name": "hooks          (Git hooks 相关)" },
    { "value": "i18n", "name": "i18n           (国际化相关)" },
    { "value": "lint", "name": "lint           (Lint 配置)" },
    { "value": "mock", "name": "mock           (Mock 数据相关)" },
    { "value": "modules", "name": "modules        (业务模块相关)" },
    { "value": "request", "name": "request        (HTTP 请求相关)" },
    { "value": "router", "name": "router         (路由相关)" },
    { "value": "store", "name": "store          (Pinia store 相关)" },
    { "value": "styles", "name": "styles         (全局样式相关)" },
    { "value": "tests", "name": "tests          (测试用例相关)" },
    { "value": "theme", "name": "theme          (主题相关)" },
    { "value": "user", "name": "user           (用户模块相关)" },
    { "value": "utils", "name": "utils          (工具方法相关)" },
    { "value": "views", "name": "views          (页面相关)" },
    { "value": "custom", "name": "custom         (以上都不是？我要自定义)" }
  ],
  "allowCustomScopes": true,
  "allowBreakingChanges": ["feat", "fix", "refactor", "perf"],
  "subjectLimit": 72,
  "breaklineChar": "|",
  "footerPrefix": "ISSUES CLOSED:",
  "allowTicketNumber": false,
  "isTicketNumberRequired": false,
  "ticketNumberPrefix": "TICKET-",
  "ticketNumberRegExp": "\\d{1,5}",
  "messages": {
    "type": "确保本次提交遵循 Angular 规范！文档：https://github.com/angular/angular/blob/main/CONTRIBUTING.md \n选择你要提交的类型（必选）：",
    "scope": "选择一个影响范围（可选）：",
    "customScope": "请输入自定义修改范围（可选）：",
    "subject": "填写简短精炼的变更描述（必填）：",
    "body": "填写更加详细的变更描述（可选）。使用 \"|\" 换行：",
    "breaking": "列举非兼容性重大的变更（可选）：",
    "footer": "列举出所有变更的 ISSUES CLOSED（可选）。 例如: #31, #34：",
    "confirmCommit": "确认提交？"
  }
}
