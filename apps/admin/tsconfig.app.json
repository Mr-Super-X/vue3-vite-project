{
  "extends": "./tsconfig.app.base.json",
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue", "../../packages/shared/src/**/*.d.ts"],
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@api": ["../../packages/shared/src/api/index.ts"],
      "@api/*": ["../../packages/shared/src/api/*"],
      "@assets": ["./src/assets/index.ts"],
      "@assets/*": ["./src/assets/*"],
      "@components": ["./src/components/index.ts"],
      "@components/*": ["./src/components/*"],
      "@composables": ["../../packages/shared/src/composables/index.ts"],
      "@composables/*": ["../../packages/shared/src/composables/*"],
      "@directives": ["../../packages/shared/src/directives/index.ts"],
      "@directives/*": ["../../packages/shared/src/directives/*"],
      "@enums": ["../../packages/shared/src/enums/index.ts"],
      "@enums/*": ["../../packages/shared/src/enums/*"],
      "@layouts": ["./src/layouts/index.ts"],
      "@layouts/*": ["./src/layouts/*"],
      "@locales": ["../../packages/shared/src/locales/index.ts"],
      "@locales/*": ["../../packages/shared/src/locales/*"],
      "@mock": ["../../packages/mock/src/index.ts"],
      "@mock/*": ["../../packages/mock/src/*"],
      "@modules": ["./src/modules/index.ts"],
      "@modules/*": ["./src/modules/*"],
      "@plugins": ["./src/plugins/index.ts"],
      "@plugins/*": ["./src/plugins/*"],
      "@router": ["./src/router/index.ts"],
      "@router/*": ["./src/router/*"],
      "@store": ["../../packages/shared/src/store/index.ts"],
      "@store/*": ["../../packages/shared/src/store/*"],
      "@types": ["../../packages/shared/src/types/index.ts"],
      "@types/*": ["../../packages/shared/src/types/*"],
      "@utils": ["../../packages/shared/src/utils/index.ts"],
      "@utils/*": ["../../packages/shared/src/utils/*"]
    }
  }
}
