{
  "name": "@vv-app/big",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "cross-env VITE_MENU_SOURCE=local vite",
    "build": "run-s \"build-only {@}\" \"type-check:full\" --",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "type-check:full": "vue-tsc --build --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vv/mock": "workspace:*",
    "@vv/shared": "workspace:*",
    "@vv/ui": "workspace:*"
  },
  "devDependencies": {
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.9",
    "@vv/config": "workspace:*"
  }
}
