# 路由部署基础路径（必须以 `/` 开头和结尾，nginx 配置时请保持一致）
VITE_BASE=/gm-portal-fe/
# 控制全局应用中文名称
VITE_APP_TITLE=工贸统一登录门户
# 控制全局缓存命名空间
VITE_STORAGE_NAMESPACE=gm-portal-fe
# 控制路由历史模式（web | hash，用于子路径或静态托管部署）
VITE_HISTORY_MODE=web
# 控制业务品牌色（HEX，覆盖 Element Plus 默认蓝 `#409eff`，含灯色阶联动，详见 [docs/06-主题管理规范.md]
VITE_BRAND_COLOR=#409eff
# 路由菜单加载模式（local | remote）
VITE_MENU_SOURCE=remote

