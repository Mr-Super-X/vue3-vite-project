# ─────────────────────────────────────────────────────────────
# Monorepo 共享默认配置（env 层级第 ③ 级）
# 优先级：shell env > apps/<a>/.env（同名键覆盖本文件）> 本文件 > 代码 fallback
# 只收跨 app 同构的默认；单个 app 的差异键写到对应 apps/<a>/.env
# 消费机制：packages/config 工厂 loadEnv 双层 merge 后全量 define 注入
# （vite 原生 envDir 只认 appRoot，不经 define 注入 client 侧读不到本文件的键）
# ─────────────────────────────────────────────────────────────

# 控制全局缓存命名空间（persist key 前缀，与展示用 VITE_APP_TITLE 解耦）
VITE_STORAGE_NAMESPACE=vue3-vite-project
# 控制 BEM 命名空间前缀（组件样式类名；TS 端 bem.ts 与 scss mixin 双端同源）
VITE_BEM_PREFIX=vv
# 控制路由历史模式（web | hash；子路径 / 静态托管部署用 hash）
VITE_HISTORY_MODE=web
# 控制业务品牌色（HEX，覆盖 Element Plus 默认蓝，含灯色阶联动，详见 docs/06）
VITE_BRAND_COLOR=#409eff
# 控制路由菜单加载模式（local | remote；local 形态走 pnpm dev:local 自动注入）
VITE_MENU_SOURCE=remote
# 统一登录应用（apps/auth）origin/路径前缀（P4 跨应用登录协议）
VITE_AUTH_ORIGIN=/auth
