      "css": ".ds-portal-header { position: sticky; top: 0; z-index: 1020; height: 64px; background: var(--portal-paper, #ffffff); border-bottom: 1px solid var(--portal-line, #eeeeee); } .ds-portal-header-inner { max-width: 1200px; height: 64px; margin: 0 auto; padding: 0 24px; display: flex; align-items: center; justify-content: space-between; } .ds-portal-logo { font-size: 16px; font-weight: 700; color: var(--portal-ink, #111111); letter-spacing: 0.02em; } .ds-portal-nav { display: flex; gap: 32px; } .ds-portal-nav a { font-size: 14px; font-weight: 500; color: var(--portal-ink, #111111); text-decoration: none; opacity: 0.75; transition: opacity 150ms cubic-bezier(0.16, 1, 0.3, 1); } .ds-portal-nav a:hover { opacity: 1; } .ds-portal-nav a.is-active { opacity: 1; box-shadow: inset 0 -2px 0 var(--portal-ink, #111111); }"
