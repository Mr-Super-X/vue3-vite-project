      "html": "<div class=\"ds-card\"><div class=\"ds-card-title\">卡片标题</div><div class=\"ds-card-body\">卡片内容，静息零阴影。</div></div>",
      "css": ".ds-card { padding: 16px; background: var(--bg-base, #ffffff); border: 1px solid var(--border-light, #e4e7ed); border-radius: 8px; transition: box-shadow 150ms cubic-bezier(0.16, 1, 0.3, 1), transform 150ms cubic-bezier(0.16, 1, 0.3, 1); } .ds-card:hover { box-shadow: 0 1px 2px rgba(0, 0, 0, 0.06); transform: translateY(-1px); } .ds-card-title { margin-bottom: 8px; font-size: 16px; font-weight: 600; color: var(--text-primary, #303133); } .ds-card-body { font-size: 14px; line-height: 1.5; color: var(--text-regular, #606266); }"
    },
