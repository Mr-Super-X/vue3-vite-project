{
  "extends": "../shared/tsconfig.base.json",
  "include": [
    "src/**/*",
    "src/**/*.vue",
    "../shared/src/types/env.d.ts",
    "../shared/src/types/sortablejs.d.ts",
    "../shared/src/types/auto-globals.d.ts"
  ],
  // 与 admin 语义对齐：spec 文件不做静态检查（apps/admin/tsconfig.app.base.json 同样排除
  // *.spec.ts；spec 由 vitest 运行时验证）。包内 spec 存量类型杂音不属于静态门禁范围。
  "exclude": ["src/**/*.spec.ts"],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    // workspace 包 exports 深路径（如 '@vv/shared/api/error-events'）的类型解析：
    // vue-tsc --build 对 peerDependencies 形态的 workspace 链接不走 exports "./*" 通配，
    // 需 paths 显式兜底（2026-10-27 error-events 引入实测：vite/vitest 走 exports 正常，
    // 仅 vue-tsc 解析失败）
    "paths": {
      "@vv/shared": ["../shared/src/index.ts"],
      "@vv/shared/*": ["../shared/src/*"]
    }
  }
}
