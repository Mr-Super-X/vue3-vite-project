{
  "name": "gm-portal-fe",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "vite",
    "dev:local": "cross-env VITE_MENU_SOURCE=local vite",
    "build": "run-s type-check:full \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "type-check:full": "vue-tsc --build --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "check:routes": "node --experimental-strip-types scripts/check-routes.ts",
    "new-module": "node --experimental-strip-types scripts/new-module.ts",
    "analyze": "cross-env ANALYZE=true pnpm build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "commit": "git add . && cz",
    "commitlint": "commitlint --edit",
    "prepare": "husky"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "^1.18.1",
    "dayjs": "^1.11.21",
    "element-plus": "^2.14.3",
    "js-cookie": "^3.0.8",
    "normalize.css": "^8.0.1",
    "pinia": "^3.0.4",
    "vue": "^3.5.38",
    "vue-i18n": "^11.4.6",
    "vue-router": "^5.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/types": "^21.2.0",
    "@tsconfig/node24": "^24.0.4",
    "@types/js-cookie": "^3.0.6",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.13.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitejs/plugin-vue-jsx": "^5.1.5",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "commitizen": "^4.3.2",
    "cross-env": "^10.1.0",
    "cz-customizable": "^7.5.4",
    "eslint": "^10.7.0",
    "eslint-plugin-vue": "^10.9.2",
    "highlight.js": "11.11.1",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.8",
    "npm-run-all2": "^9.0.2",
    "only-allow": "^1.2.2",
    "pinia-plugin-persistedstate": "^4.7.1",
    "prettier": "^3.9.5",
    "rollup-plugin-visualizer": "^7.0.1",
    "sass": "^1.101.0",
    "typescript": "~6.0.0",
    "unocss": "^66.7.5",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.0.16",
    "vite-plugin-mock": "^3.0.2",
    "vite-plugin-vue-devtools": "^8.1.2",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.3.5"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0",
    "pnpm": ">=11.0.0 < 12.0.0"
  },
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "config": {
    "commitizen": {
      "path": "cz-customizable"
    }
  }
}
