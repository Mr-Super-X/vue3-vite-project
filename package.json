{
  "name": "vue3-vite-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "turbo run dev",
    "dev:local": "pnpm -C apps/admin dev:local",
    "build": "turbo run build",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "check:routes": "node --experimental-strip-types scripts/check-routes.ts",
    "check:aliases": "node --experimental-strip-types scripts/check-aliases.ts",
    "generate:tsconfig-paths": "node --experimental-strip-types scripts/generate-tsconfig-paths.ts",
    "check:doc-currency": "node --experimental-strip-types scripts/check-doc-currency.ts",
    "new-module": "node --experimental-strip-types scripts/new-module.ts",
    "remove-module": "node --experimental-strip-types scripts/remove-module.ts",
    "analyze": "cross-env ANALYZE=true pnpm -C apps/admin build-only",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "bench": "pnpm -C apps/admin bench",
    "commit": "git add . && cz",
    "push": "git add . && cz && git push",
    "release": "release-it",
    "release:dry": "release-it --dry-run",
    "commitlint": "commitlint --edit",
    "prepare": "husky"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@wangeditor/editor-for-vue": "^5.1.12",
    "axios": "^1.18.1",
    "dayjs": "^1.11.21",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.3",
    "js-cookie": "^3.0.8",
    "lodash-es": "^4.18.1",
    "normalize.css": "^8.0.1",
    "pinia": "^3.0.4",
    "sortablejs": "^1.15.7",
    "vue": "^3.5.38",
    "vue-i18n": "^11.4.6",
    "vue-router": "^5.1.0",
    "vxe-table": "^4.21.7",
    "web-vitals": "^6.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/types": "^21.2.0",
    "@iconify-json/ep": "^1.2.4",
    "@iconify-json/tabler": "^1.2.42",
    "@playwright/test": "^1.63.0",
    "@release-it/conventional-changelog": "^12.0.0",
    "@tsconfig/node24": "^24.0.4",
    "@types/js-cookie": "^3.0.6",
    "@types/jsdom": "^28.0.3",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.13.2",
    "@types/postcss-pxtorem": "^6.1.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitejs/plugin-vue-jsx": "^5.1.5",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "@wangeditor/editor": "^5.1.23",
    "commitizen": "^4.3.2",
    "cross-env": "^10.1.0",
    "cz-customizable": "^7.5.4",
    "dompurify": "^3.4.15",
    "eslint": "^10.7.0",
    "eslint-plugin-vue": "^10.9.2",
    "highlight.js": "11.11.1",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.8",
    "npm-run-all2": "^9.0.2",
    "only-allow": "^1.2.2",
    "pinia-plugin-persistedstate": "^4.7.1",
    "postcss": "8.5.19",
    "postcss-pxtorem": "^6.1.0",
    "prettier": "^3.9.5",
    "release-it": "^21.0.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "sass": "^1.101.0",
    "typescript": "~6.0.0",
    "turbo": "^2.11.0",
    "unocss": "^66.7.5",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-icons": "^24.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.0.16",
    "vite-plugin-mock": "^3.0.2",
    "vite-plugin-vue-devtools": "^8.1.2",
    "vitest": "^4.1.9",
    "vitest-axe": "^0.1.0",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0",
    "pnpm": ">=11.0.0 < 13.0.0"
  },
  "packageManager": "pnpm@12.11.2",
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "config": {
    "commitizen": {
      "path": "cz-customizable"
    }
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:Mr-Super-X/vue3-vite-project.git"
  },
  "volta": {
    "node": "22.18.0"
  }
}
