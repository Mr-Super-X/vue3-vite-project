{
  "name": "vue3-vite-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "turbo run dev",
    "dev:local": "pnpm -C apps/admin dev:local",
    "dev:gateway": "node --experimental-strip-types scripts/dev-gateway.ts",
    "dev:admin": "pnpm -C apps/admin dev",
    "dev:auth": "pnpm -C apps/auth dev",
    "dev:portal": "pnpm -C apps/portal dev",
    "dev:h5": "pnpm -C apps/h5 dev",
    "dev:big": "pnpm -C apps/big dev",
    "dev:docs": "pnpm -C apps/docs dev",
    "test:coverage": "pnpm -C apps/admin test:coverage",
    "test:ui": "pnpm -C apps/admin test:ui",
    "build": "turbo run build",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "check:routes": "node --experimental-strip-types scripts/check-routes.ts",
    "check:aliases": "node --experimental-strip-types scripts/check-aliases.ts",
    "generate:tsconfig-paths": "node --experimental-strip-types scripts/generate-tsconfig-paths.ts",
    "check:doc-currency": "node --experimental-strip-types scripts/check-doc-currency.ts",
    "check:mock-wiring": "node --experimental-strip-types scripts/check-mock-wiring.ts",
    "new-module": "node --experimental-strip-types scripts/new-module.ts",
    "new-app": "node --experimental-strip-types scripts/new-app.ts",
    "remove-module": "node --experimental-strip-types scripts/remove-module.ts",
    "analyze": "cross-env ANALYZE=true pnpm -C apps/admin build-only",
    "build:pages": "node --experimental-strip-types scripts/build-pages.ts",
    "build:prod": "node --experimental-strip-types scripts/build-prod.ts",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:gateway": "node --test --experimental-strip-types --test-force-exit scripts/node-gateway.spec.ts",
    "test:check-scripts": "node --test --experimental-strip-types --test-force-exit scripts/check-mock-wiring.spec.ts scripts/check-routes.spec.ts scripts/check-doc-currency.spec.ts",
    "test:eslint-rules": "node --test scripts/eslint-rules/package-contract.spec.mjs",
    "bench": "pnpm -C apps/admin bench",
    "commit": "git add . && cz",
    "push": "git add . && cz && git push",
    "release": "release-it",
    "release:dry": "release-it --dry-run",
    "commitlint": "commitlint --edit",
    "prepare": "husky"
  },
  "dependencies": {
    "@element-plus/icons-vue": "catalog:",
    "@wangeditor/editor-for-vue": "catalog:",
    "axios": "catalog:",
    "dayjs": "catalog:",
    "echarts": "catalog:",
    "element-plus": "catalog:",
    "js-cookie": "catalog:",
    "lodash-es": "catalog:",
    "normalize.css": "catalog:",
    "pinia": "catalog:",
    "sortablejs": "catalog:",
    "vue": "catalog:",
    "vue-i18n": "catalog:",
    "vue-router": "catalog:",
    "vxe-table": "catalog:",
    "web-vitals": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@commitlint/types": "catalog:",
    "@iconify-json/ep": "catalog:",
    "@iconify-json/tabler": "catalog:",
    "@playwright/test": "catalog:",
    "@release-it/conventional-changelog": "catalog:",
    "@tsconfig/node24": "catalog:",
    "@types/js-cookie": "catalog:",
    "@types/jsdom": "catalog:",
    "@types/lodash-es": "catalog:",
    "@types/node": "catalog:",
    "@types/postcss-pxtorem": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vitejs/plugin-vue-jsx": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "@vue/eslint-config-prettier": "catalog:",
    "@vue/eslint-config-typescript": "catalog:",
    "@vue/test-utils": "catalog:",
    "@vue/tsconfig": "catalog:",
    "@wangeditor/editor": "catalog:",
    "commitizen": "catalog:",
    "cross-env": "catalog:",
    "cz-customizable": "catalog:",
    "dompurify": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-vue": "catalog:",
    "highlight.js": "catalog:",
    "husky": "catalog:",
    "jsdom": "catalog:",
    "lint-staged": "catalog:",
    "npm-run-all2": "catalog:",
    "only-allow": "catalog:",
    "pinia-plugin-persistedstate": "catalog:",
    "postcss": "catalog:",
    "postcss-pxtorem": "catalog:",
    "prettier": "catalog:",
    "release-it": "catalog:",
    "rollup-plugin-visualizer": "catalog:",
    "sass": "catalog:",
    "typescript": "catalog:",
    "turbo": "catalog:",
    "unocss": "catalog:",
    "unplugin-auto-import": "catalog:",
    "unplugin-icons": "catalog:",
    "unplugin-vue-components": "catalog:",
    "vite": "catalog:",
    "vite-plugin-mock": "catalog:",
    "vite-plugin-vue-devtools": "catalog:",
    "vitest": "catalog:",
    "vitest-axe": "catalog:",
    "vue-tsc": "catalog:"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0",
    "pnpm": ">=11.0.0 < 13.0.0"
  },
  "packageManager": "pnpm@12.11.2",
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "config": {
    "commitizen": {
      "path": "cz-customizable"
    }
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:Mr-Super-X/vue3-vite-project.git"
  },
  "volta": {
    "node": "22.18.0"
  }
}
